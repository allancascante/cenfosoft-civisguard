        <object placeholders="1" c4Name="Availability Query Handler" c4Type="Component" c4Technology="Spring Service" c4Description="Recibe consultas de disponibilidad de recursos. Primero consulta la caché local; si no hay datos frescos, delega al Resource Availability Fetcher" label="&lt;b&gt;%c4Name%&lt;/b&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;%c4Description%&lt;/div&gt;" id="comp-query-handler">
