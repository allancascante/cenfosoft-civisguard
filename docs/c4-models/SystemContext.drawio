        <object placeholders="1" c4Name="Dispatch Confirmation Handler" c4Type="Component" c4Technology="Spring Service" c4Description="Recibe confirmaciones de cada institución. Cuando todas confirman dentro del límite de 90 segundos, publica el evento RecursosDespachados a Kafka" label="&lt;b&gt;%c4Name%&lt;/b&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;%c4Description%&lt;/div&gt;" id="comp-confirmation">
