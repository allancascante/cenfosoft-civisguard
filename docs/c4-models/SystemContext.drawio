        <object placeholders="1" c4Name="Dispatch Command Handler" c4Type="Component" c4Technology="Spring Service" c4Description="Recibe el comando de despacho validado desde el API Gateway. Inicia la Saga de coordinación interinstitucional" label="&lt;b&gt;%c4Name%&lt;/b&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;%c4Description%&lt;/div&gt;" id="comp-command-handler">
