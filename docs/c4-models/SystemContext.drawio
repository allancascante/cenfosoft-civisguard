          </mxCell>
        </object>
        <object placeholders="1" c4Name="Dispatch Saga Orchestrator" c4Type="Component" c4Technology="Spring State Machine" c4Description="Coordinador central de la Saga. Gestiona el flujo: solicitar recursos → confirmar por institución → confirmar despacho global o compensar si alguna institución falla" label="&lt;b&gt;%c4Name%&lt;/b&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;%c4Description%&lt;/div&gt;" id="comp-saga">
